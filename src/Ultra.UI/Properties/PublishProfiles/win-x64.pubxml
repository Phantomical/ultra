<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone Windows x64 release of the UI: a self-contained folder (no .NET install needed) and a zip of it.

    cd src
    dotnet publish Ultra.UI -p:PublishProfile=win-x64

  Output: artifacts/ultra-ui-win-x64/ and artifacts/ultra-ui-<version>-win-x64.zip
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Keep a folder: TraceEvent loads its native DLLs (amd64\KernelTraceControl.dll, msdia140.dll) from beside the
         exe, and the elevated worker relaunches ultra-ui.exe itself. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Partial trimming only trims assemblies marked trimmable (mostly the framework). TraceEvent,
         Microsoft.Diagnostics.NETCore.Client and Ultra.Core use reflection that full trimming breaks. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- The analyzer still reports reflection in those untrimmed assemblies; it is kept whole, so the warnings are
         noise here. Remove this when trying full trimming. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <UltraArtifactsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'artifacts'))</UltraArtifactsDir>
    <PublishDir>$(UltraArtifactsDir)ultra-ui-win-x64\</PublishDir>
  </PropertyGroup>

  <!-- Start from an empty folder so files from an earlier publish don't end up in the zip. -->
  <Target Name="UltraCleanPublishDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <!-- Drop files a Windows x64 build never uses: native PDBs of packages (~100 MB for SkiaSharp/HarfBuzz),
       the macOS sampler dylibs and the arm64 TraceEvent natives. -->
  <Target Name="UltraTrimPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and '%(ResolvedFileToPublish.AssetType)' == 'native'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dylib'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('arm64'))" />
    </ItemGroup>
  </Target>

  <Target Name="UltraZipPublishDir" AfterTargets="Publish">
    <ZipDirectory SourceDirectory="$(PublishDir)"
                  DestinationFile="$(UltraArtifactsDir)ultra-ui-$(Version)-win-x64.zip"
                  Overwrite="true" />
    <Message Importance="high" Text="Ultra.UI -> $(UltraArtifactsDir)ultra-ui-$(Version)-win-x64.zip" />
  </Target>
</Project>
